# Zerodha Kite Connect API Credentials
# Create an app at https://developers.kite.trade to get your API Key and Secret
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Daily Access Token
# Run `python authenticate.py` each morning to generate and store this token
KITE_ACCESS_TOKEN=your_daily_access_token_here

# Google Gemini API Key (Free from https://aistudio.google.com/)
# Enables automated AI executive summaries, risk scoring, and investment verdict
GEMINI_API_KEY=your_gemini_api_key_here
